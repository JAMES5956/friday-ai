# Copy to .env.local. Never commit real credentials.

# Supabase project settings (required for authentication and persistent data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
FRIDAY_OWNER_EMAIL=

# Encryption key for private memory and chat data (32 bytes, base64).
# Generate locally with: openssl rand -base64 32
FRIDAY_DATA_ENCRYPTION_KEY=

# Server-side model provider. Use an OpenAI-compatible endpoint.
# Keep the API key server-side; never prefix it with NEXT_PUBLIC_.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Optional application origin used for auth callback URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Twilio phone calling. Keep disabled until the provider and costs are approved.
FRIDAY_TELEPHONY_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+10000000000
FRIDAY_OWNER_PHONE=+10000000000
# Public HTTPS origin only, e.g. https://friday.example.com
FRIDAY_PUBLIC_BASE_URL=
# Twilio voice name and speech recognition language
FRIDAY_TWILIO_VOICE=Polly.Amy
FRIDAY_CALL_LANGUAGE=en-GB

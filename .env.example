# Copy to .env.local. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
FRIDAY_OWNER_EMAIL=
# 32-byte base64 key; generate with: openssl rand -base64 32
FRIDAY_DATA_ENCRYPTION_KEY=
# Server-side OpenAI-compatible provider; never expose the key with NEXT_PUBLIC_.
AI_BASE_URL=
AI_API_KEY=
# General FRIDAY model and optional routing tiers.
# Each specialist requires its own dedicated model name; no general-model fallback is used for delegated tasks.
AI_MODEL=
AI_FAST_MODEL=
AI_REASONING_MODEL=
# Specialist models (configure only the specialists you intend to enable).
AI_ATLAS_MODEL=
AI_ORACLE_MODEL=
AI_FORGE_MODEL=
AI_BYTE_MODEL=
AI_VANTAGE_MODEL=
AI_SAGE_MODEL=
AI_PIXEL_MODEL=
AI_SCOUT_MODEL=
AI_VIGOR_MODEL=
AI_PROBE_MODEL=
AI_STRESS_MODEL=
AI_AEGIS_MODEL=
AI_METRIC_MODEL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional calling integration remains disabled pending explicit approval.
FRIDAY_TELEPHONY_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+10000000000
FRIDAY_OWNER_PHONE=+10000000000
FRIDAY_PUBLIC_BASE_URL=
FRIDAY_TWILIO_VOICE=Polly.Amy
FRIDAY_CALL_LANGUAGE=en-GB
